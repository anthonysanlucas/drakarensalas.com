---
const WHATSAPP_URL = 'https://wa.me/593998269425';
---

<section class="bg-mist py-20 text-center lg:py-28" id="contacto">
  <div class="mx-auto max-w-130 px-6" data-reveal>
    <span class="eyebrow">Contacto</span>
    <h2 class="mt-3.5 font-serif text-[34px] font-medium text-ink">Conversemos sobre tu próxima cita</h2>
    <p class="mt-4 mb-9 text-base leading-relaxed text-ink-soft">Escríbeme por WhatsApp y coordinamos un horario que te acomode.</p>
    <a class="btn-primary" href={WHATSAPP_URL} target="_blank" rel="noopener">
      Agendar por WhatsApp
    </a>

    <div class="mt-10 flex flex-wrap justify-center gap-7 text-sm text-ink-soft">
      <span class="flex items-center gap-1.5">
        <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M12 22s7-7.58 7-12.5A7 7 0 0 0 5 9.5C5 14.42 12 22 12 22Z"></path>
          <circle cx="12" cy="9.5" r="2.4"></circle>
        </svg>
        Guayaquil, Ecuador
      </span> 
    </div>
  </div>
</section>
