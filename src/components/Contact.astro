---
const WHATSAPP_URL = 'https://wa.me/593998269425';
---

<section class="bg-mist py-24 text-center lg:py-32" id="contacto">
  <div class="mx-auto max-w-[520px] px-7" data-reveal>
    <span class="text-[12.5px] font-semibold uppercase tracking-[0.16em] text-blue">Contacto</span>
    <h2 class="mt-3.5 font-serif text-[34px] font-medium text-ink">Conversemos sobre tu próxima cita</h2>
    <p class="mt-4 mb-9 text-base text-ink-soft">Escríbeme por WhatsApp y coordinamos un horario que te acomode.</p>
    <a
      class="inline-flex items-center gap-2 rounded-xs border border-blue-deep bg-blue-deep px-6 py-3 text-[14.5px] font-medium text-white transition-all duration-200 hover:-translate-y-0.5 hover:border-ink hover:bg-ink motion-reduce:hover:translate-y-0"
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener"
    >
      Agendar por WhatsApp
    </a>

    <div class="mt-10 flex flex-wrap justify-center gap-7 text-sm text-ink-soft">
      <span class="flex items-center gap-1.5">
        <svg class="h-4 w-4 text-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M12 22s7-7.58 7-12.5A7 7 0 0 0 5 9.5C5 14.42 12 22 12 22Z"></path>
          <circle cx="12" cy="9.5" r="2.4"></circle>
        </svg>
        Guayaquil, Ecuador
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="h-4 w-4 text-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M21 15a4 4 0 0 1-4 4H8l-5 3 1-4.5A4 4 0 0 1 3 15V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
        </svg>
        +593 99 826 9425
      </span>
    </div>
  </div>
</section>
