---
import { siWhatsapp } from "simple-icons";

const WHATSAPP_URL = "https://wa.me/593998269425";
---

<section class="bg-mist py-20 text-center lg:py-28" id="contacto">
  <div class="mx-auto max-w-xl px-6" data-reveal>
    <span class="eyebrow">Contacto</span>
    <h2 class="mt-3.5 font-serif text-balance text-[34px] font-medium text-ink">
      Conversemos sobre tu próxima cita
    </h2>
    <p class="mt-4 mb-9 text-base text-pretty leading-relaxed text-ink-soft">
      Escríbeme por WhatsApp y coordinamos un horario que te acomode.
    </p>
    <a class="btn-primary" href={WHATSAPP_URL} target="_blank" rel="noopener">
      <svg
        viewBox="0 0 24 24"
        class="size-4 shrink-0"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d={siWhatsapp.path}></path>
      </svg>
      Agendar por WhatsApp
    </a>
  </div>
</section>
