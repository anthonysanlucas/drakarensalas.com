---
const WHATSAPP_URL = 'https://wa.me/593998269425';
---

<section class="relative overflow-hidden bg-bg py-14 sm:py-20 lg:py-28">
  <svg
    class="pointer-events-none absolute -top-10 -right-40 w-140 max-w-[60vw] opacity-70 motion-reduce:opacity-30"
    viewBox="0 0 640 400"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path d="M20 260C160 380 480 380 620 200" stroke="#3FA893" stroke-opacity="0.22" stroke-width="1.5"></path>
    <path d="M60 300C190 400 470 400 600 240" stroke="#1F4B57" stroke-opacity="0.14" stroke-width="1.5"></path>
  </svg>

  <div class="relative mx-auto max-w-285 px-6 sm:px-8">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_360px] lg:gap-16">
      <div class="order-2 mx-auto aspect-4/5 w-full max-w-65 overflow-hidden rounded-3xl bg-mist shadow-soft-lg lg:order-2 lg:mx-0 lg:max-w-none">
        <img
          src="/karensalas-odontologa-guayaquil.png"
          alt="Retrato profesional de la Dra. Karen Salas — imagen provisional, pendiente reemplazo por foto real"
          width="680"
          height="850"
          class="h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="order-1 max-w-140 lg:order-1" data-reveal>
        <span class="eyebrow">Odontóloga</span>
        <h1 class="mt-4 font-serif text-[clamp(38px,5.4vw,58px)] leading-[1.05] font-medium tracking-[-0.01em] text-ink">
          Dra. Karen<br />Salas
        </h1>
        <p class="mt-5 max-w-115 text-[18px] leading-relaxed text-ink-soft">
          Atención dental cuidadosa, cercana y responsable, con comunicación clara en cada consulta.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-5">
          <a class="btn-primary" href={WHATSAPP_URL} target="_blank" rel="noopener">
            Agendar por WhatsApp
          </a>
          <span class="flex items-center gap-1.5 text-sm text-ink-soft">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M12 22s7-7.58 7-12.5A7 7 0 0 0 5 9.5C5 14.42 12 22 12 22Z"></path>
              <circle cx="12" cy="9.5" r="2.4"></circle>
            </svg>
            Guayaquil, Ecuador
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
