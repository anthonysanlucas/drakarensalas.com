---
import { siWhatsapp } from "simple-icons";

const WHATSAPP_URL = "https://wa.me/593998269425";
---

<section class="relative overflow-hidden bg-bg py-12 sm:py-16 lg:py-20">
  <div class="relative mx-auto max-w-285 px-6 sm:px-8">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_380px] lg:gap-16">
      <div class="max-w-140" data-reveal>
        <span class="eyebrow">Odontóloga en Guayaquil</span>
        <h1
          class="mt-4 font-serif text-[clamp(34px,5vw,54px)] leading-[1.08] font-medium tracking-[-0.01em] text-ink"
        >
          Cuidado dental claro,<br />cercano y sin apuros.
        </h1>
        <p class="mt-5 max-w-115 text-[18px] leading-relaxed text-ink-soft">
          Soy Karen Salas, odontóloga enfocada en ayudarte a entender tu salud
          oral y tomar decisiones con confianza desde la primera consulta.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            class="btn-primary"
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-4 shrink-0"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={siWhatsapp.path}></path>
            </svg>
            Agendar por WhatsApp
          </a>
          <a class="btn-secondary" href="#servicios"> Ver servicios </a>
        </div>
      </div>

      <div
        class="relative isolate mx-auto w-full max-w-80 lg:mx-0 lg:max-w-none"
        data-reveal
      >
        <div
          class="absolute -inset-6 -z-10 rounded-full bg-[radial-gradient(closest-side,rgba(63,168,147,0.5),rgba(227,243,239,0.35)_60%,transparent_100%)] blur-lg motion-reduce:blur-md"
          aria-hidden="true"
        >
        </div>
        <div
          class="hero-photo relative z-10 aspect-464/710 w-full overflow-hidden rounded-t-[2.5rem]"
        >
          <img
            src="/karensalas-odontologa-guayaquil.png"
            alt="Retrato profesional de la Dra. Karen Salas — imagen provisional, pendiente de reemplazo por foto real"
            width="464"
            height="710"
            class="h-full w-full object-cover object-top"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-photo {
    filter: drop-shadow(0 12px 20px rgba(31, 58, 65, 0.12));
  }

  .hero-photo img {
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 88%,
      transparent 100%
    );
    mask-image: linear-gradient(to bottom, #000 0%, #000 88%, transparent 100%);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo {
      filter: none;
    }
  }
</style>
