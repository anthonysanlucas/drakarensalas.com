---
// Assets temporales — reemplazar por fotografías reales cuando estén disponibles.
const aboutImage1 = {
  src: '/about-consultorio.jpg',
  alt: 'Espacio de atención dental',
};
const aboutImage2 = {
  src: '/about-detalle.jpg',
  alt: 'Detalle de cuidado dental preventivo',
};

const principles = [
  'Escucho tu caso antes de recomendar.',
  'Te explico cada paso en lenguaje simple.',
  'Priorizo el cuidado preventivo y responsable.',
  'Coordinamos tu atención de forma clara por WhatsApp.',
];
---

<section id="perfil" class="bg-bg py-20 lg:py-28">
  <div class="mx-auto max-w-285 px-6 sm:px-8">
    <div class="mb-10 flex items-baseline gap-4" data-reveal>
      <span class="eyebrow">Sobre mí</span>
      <span class="h-px flex-1 bg-border"></span>
    </div>

    <div class="grid items-start gap-12 lg:grid-cols-[440px_1fr] lg:gap-16">
      <div class="max-w-125" data-reveal>
        <h2 class="font-serif text-[clamp(28px,3.4vw,38px)] leading-[1.15] font-medium text-ink">
          Una atención dental cercana y fácil de entender.
        </h2>
        <p class="mt-5 text-[17px] leading-relaxed text-ink-soft">
          Soy Karen Salas, odontóloga graduada con una forma de atención clara, responsable y cercana. Mi objetivo es ayudarte a entender tu salud oral, resolver tus dudas y acompañarte en cada paso de tu cuidado dental.
        </p>
        <p class="mt-4 text-[17px] leading-relaxed text-ink-soft">
          Creo en una atención sin apuros, donde cada paciente pueda preguntar con confianza y recibir una explicación sencilla antes de tomar cualquier decisión.
        </p>

        <div class="mt-8 rounded-3xl border border-border bg-mist/60 p-6 sm:p-7">
          <h3 class="text-[12.5px] font-semibold uppercase tracking-[0.09em] text-ink">Mi forma de atender</h3>
          <ul class="mt-4 space-y-3.5">
            {principles.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-full bg-accent-soft text-accent">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 12.5l4.5 4.5L20 6"></path>
                  </svg>
                </span>
                <span class="text-[15px] leading-relaxed text-ink-soft">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="relative lg:order-first" data-reveal>
        <div class="relative mx-auto w-full max-w-105 lg:mx-0 lg:max-w-none">
          <div
            class="absolute -inset-3 -z-10 rounded-4xl bg-linear-to-br from-accent-soft to-mist-deep/70"
            aria-hidden="true"
          >
          </div>

          <div class="grid grid-cols-2 gap-4 sm:gap-5">
            <div class="aspect-square overflow-hidden rounded-3xl border border-border shadow-soft">
              <img
                src={aboutImage1.src}
                alt={aboutImage1.alt}
                width="480"
                height="480"
                class="h-full w-full object-cover"
                loading="eager"
              />
            </div>
            <div class="aspect-square overflow-hidden rounded-3xl border border-border shadow-soft mt-10 sm:mt-14">
              <img
                src={aboutImage2.src}
                alt={aboutImage2.alt}
                width="480"
                height="480"
                class="h-full w-full object-cover"
                loading="eager"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
