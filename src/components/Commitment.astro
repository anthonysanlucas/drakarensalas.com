---
const commitments = [
  {
    quote: 'Atiendo cada caso con seriedad y le doy seguimiento hasta que quede resuelto.',
    label: 'Atención responsable',
  },
  {
    quote: 'Quiero que te sientas cómodo/a para preguntar todo lo que necesites, sin apuro.',
    label: 'Trato cercano',
  },
  {
    quote: 'Reviso cada detalle, desde el diagnóstico hasta la explicación del tratamiento.',
    label: 'Cuidado en el detalle',
  },
  {
    quote: 'Explico todo en un lenguaje simple, sin tecnicismos ni información a medias.',
    label: 'Comunicación clara',
  },
];
---

<section id="confianza" class="bg-bg py-20 lg:py-28">
  <div class="mx-auto max-w-285 px-6 sm:px-8">
    <div class="mb-10 flex items-baseline gap-4" data-reveal>
      <span class="eyebrow">Mi compromiso contigo</span>
      <span class="h-px flex-1 bg-border"></span>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
      {commitments.map((item) => (
        <div class="card flex flex-col gap-3.5 p-6 hover:-translate-y-0.5 hover:border-accent hover:shadow-soft-lg motion-reduce:hover:translate-y-0">
          <span class="font-serif text-[34px] leading-none text-accent" aria-hidden="true">”</span>
          <p class="text-[14.5px] leading-relaxed text-ink italic">{item.quote}</p>
          <span class="mt-auto flex items-center gap-2 text-[12.5px] text-ink-soft not-italic">

            {item.label}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
